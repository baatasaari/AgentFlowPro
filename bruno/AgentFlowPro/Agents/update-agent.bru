meta {
  name: Update Agent
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/agents/{{agentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "active",
    "greetingMessage": "Namaste! 🙏 Welcome to Dr Sharma Clinic. How may I assist you today?"
  }
}
