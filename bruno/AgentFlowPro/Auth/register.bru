meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "owner@testclinic.com",
    "username": "testclinic",
    "password": "TestPass123!",
    "firstName": "Rahul",
    "lastName": "Sharma",
    "organizationName": "Dr Sharma Clinic"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
  }
}
