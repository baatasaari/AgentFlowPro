# Google AI Studio key (for LiteLLM → Gemini API)
GOOGLE_API_KEY=your-google-ai-studio-api-key

# LiteLLM model (default: gemini/gemini-2.5-flash-lite)
LITELLM_MODEL=gemini/gemini-2.5-flash-lite

# For Vertex AI deployment (optional — needed for deploy.py)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_STAGING_BUCKET=gs://your-bucket/staging

# Agent Engine resource name (set after deploy.py runs — used by Express backend)
# Format: projects/{PROJECT}/locations/{LOCATION}/reasoningEngines/{ID}
AGENT_ENGINE_RESOURCE_NAME=
