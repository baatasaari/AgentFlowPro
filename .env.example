# ─── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string (Neon serverless or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/agentflowpro

# ─── Authentication ───────────────���─────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 64
JWT_SECRET=your-secret-key-minimum-32-characters-change-in-production

# ─── Application ───────���─────────────────────────────────��─────────────────────
NODE_ENV=production
PORT=5000

# ─── Email (optional — enables transactional email) ──────��─────────────────────
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=noreply@agentflow.com

# ─── Stripe (optional — enables billing) ───────────────────────────────────────
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Monitoring (optional) ─────────────��───────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
